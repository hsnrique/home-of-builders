{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home of Builders",
  "version": "0.1.0",
  "identifier": "com.homeofbuilders.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Home of Builders",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../agents/core/": "library/agents/core/",
      "../../catalog/": "library/catalog/",
      "../../STANDARD.md": "library/STANDARD.md"
    },
    "category": "DeveloperTool",
    "shortDescription": "Build elite marketing agents for Claude Code",
    "copyright": "Copyright (c) 2026 Henrique Braga. MIT License."
  }
}
